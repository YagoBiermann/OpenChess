{
  "ConnectionStrings": {
    "https_port": "443"
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:443",
    "Headers": {
      "ApiKey": "X-Api-Key"
    },
    "Endpoints": {
      "JoinAction": "/api/matches/{id}/actions/join",
      "PlayAction": "/api/matches/{id}/actions/play",
      "ResignAction": "/api/matches/{id}/actions/resign",
      "TimeoutAction": "/api/matches/{id}/actions/timeout",
      "CreateCustomMatch": "api/matches",
      "CreateMatch": "/internal/api/matches",
      "CreatePlayer": "/api/players"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}